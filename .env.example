MONGODB_URI=mongodb://127.0.0.1:27017/novatrixai
# Alias accepté à la place de MONGODB_URI (ex. connexion Atlas)
# NUXT_MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/novatrixai
AUTH_SESSION_SECRET=change-me-with-at-least-32-random-characters
ADMIN_EMAIL=admin@novatrixai.com
ADMIN_PASSWORD=change-this-password
AUTOPUBLISH_API_KEY=change-this-api-key
NUXT_CLOUDINARY_CLOUD_NAME=
NUXT_CLOUDINARY_API_KEY=
NUXT_CLOUDINARY_API_SECRET=
# S3/R2 : solution de secours si Cloudinary n'est pas configuré (image et fichiers passent alors par S3)
S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
S3_BUCKET=novatrix-resources
S3_KEY=
S3_SECRET=
ALLOW_DEMO_DOWNLOADS=false
N8N_WEBHOOK_URL=
GHL_WEBHOOK_URL=
# SMTP Hostinger (465 = TLS implicite ; 587 = STARTTLS)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@novatrixai.com
SMTP_PASS=
MAIL_FROM=NovatrixAI <contact@novatrixai.com>
# Destinataire interne des alertes nouveau lead (sinon reglage admin, sinon MAIL_FROM)
MAIL_TO_INTERNAL=contact@novatrixai.com
SITE_URL=http://localhost:3000
NUXT_PUBLIC_CALENDAR_URL=https://calendly.com/novatrix217/audit-gratuit
# Numero WhatsApp reel au format international, sans + ni espaces. Vide = CTA masques.
NUXT_PUBLIC_WHATSAPP_URL=
